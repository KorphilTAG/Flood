{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flood.local/schemas/scenario.schema.json",
  "title": "Scenario file (contract 0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "name", "timezone", "hydrology", "forcing_defaults", "exposure_layers"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "scenario_id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "timezone": { "type": "string", "description": "IANA zone for display, e.g. America/Chicago" },
    "hydrology": {
      "type": "object", "additionalProperties": false,
      "required": ["huc8", "fim_version", "aoi", "record", "gauges"],
      "properties": {
        "huc8": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/huc8" }, "uniqueItems": true },
        "fim_version": { "$ref": "common.schema.json#/$defs/fim_version" },
        "aoi": {
          "type": "object", "additionalProperties": false,
          "required": ["crs", "bounds"],
          "properties": {
            "crs": { "const": "EPSG:5070" },
            "bounds": { "$ref": "common.schema.json#/$defs/bounds" }
          }
        },
        "record": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
            "end": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
          }
        },
        "gauges": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["site", "feature_id", "role"],
            "properties": {
              "site": { "$ref": "common.schema.json#/$defs/usgs_site" },
              "name": { "type": "string" },
              "feature_id": { "type": "integer", "minimum": 1 },
              "role": { "type": "string", "enum": ["boundary", "interior", "validation_only"] }
            }
          }
        },
        "junction_inferences": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "inferred_reach", "downstream_gauge", "subtract_gauges", "travel_time_minutes"],
            "properties": {
              "label": { "type": "string" },
              "inferred_reach": { "type": "integer", "minimum": 1 },
              "downstream_gauge": { "$ref": "common.schema.json#/$defs/usgs_site" },
              "subtract_gauges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/usgs_site" } },
              "travel_time_minutes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "forcing_defaults": { "$ref": "forcing-config.schema.json" },
    "exposure_layers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer_id", "name", "source", "id_field", "geometry"],
        "properties": {
          "layer_id": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/layer_id" },
              { "not": { "enum": ["reach", "gauge", "aar"] } }
            ]
          },
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "id_field": { "type": "string", "minLength": 1 },
          "geometry": { "type": "string", "enum": ["point", "line", "polygon"] },
          "attributes": { "type": "array", "items": { "type": "string" }, "default": [] },
          "impact": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "impassable_depth_m": { "type": "number", "minimum": 0 },
              "threatened_depth_m": { "type": "number", "minimum": 0 },
              "hazard_dv_limit": { "type": "number", "minimum": 0 }
            }
          },
          "egress": {
            "type": "object", "additionalProperties": false,
            "required": ["routes_layer", "join_field"],
            "properties": {
              "routes_layer": { "$ref": "common.schema.json#/$defs/layer_id" },
              "join_field": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "t", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "t": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
          "label": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string" },
          "reference_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/feature_ref" } }
        }
      }
    },
    "last_known_positions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "t", "lon", "lat"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "t": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
