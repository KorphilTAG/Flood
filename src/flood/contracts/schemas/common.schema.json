{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flood.local/schemas/common.schema.json",
  "title": "Shared definitions for all Flood contracts",
  "$defs": {
    "schema_version": { "type": "string", "const": "1.0" },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC, second precision, Z suffix"
    },
    "compact_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z$",
      "description": "Path form, e.g. 20250704T0614Z"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "layer_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "feature_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}:[A-Za-z0-9_.-]{1,64}$" },
    "reach_ref": { "type": "string", "pattern": "^reach:[0-9]{1,12}$" },
    "gauge_ref": { "type": "string", "pattern": "^gauge:[0-9]{8,15}$" },
    "usgs_site": { "type": "string", "pattern": "^[0-9]{8,15}$" },
    "huc8": { "type": "string", "pattern": "^[0-9]{8}$" },
    "fim_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bounds": {
      "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
      "description": "[xmin, ymin, xmax, ymax]"
    },
    "affine": {
      "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6,
      "description": "GDAL order [a, b, c, d, e, f]"
    },
    "member": { "type": "string", "enum": ["low", "mid", "high"] },
    "members": {
      "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 3, "maxItems": 3, "uniqueItems": true
    },
    "source_kind": {
      "type": "string",
      "enum": ["observed", "nwm_analysis_scaled", "mass_balance", "nwm_analysis", "routed", "forecast_trend", "forecast_nwm_sr"]
    },
    "non_negative": { "type": "number", "minimum": 0 }
  }
}
