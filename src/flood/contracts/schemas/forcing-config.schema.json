{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flood.local/schemas/forcing-config.schema.json",
  "title": "Forcing configuration (contract 1, section 8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "state_estimation", "boundary_forecast", "routing"],
  "properties": {
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "availability_latency_min", "sites"],
            "properties": {
              "type": { "const": "usgs_continuous" },
              "availability_latency_min": { "type": "integer", "minimum": 0 },
              "sites": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/usgs_site" } },
              "parameters": {
                "type": "array", "items": { "type": "string", "enum": ["00060", "00065"] },
                "default": ["00060", "00065"], "uniqueItems": true
              }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "availability_latency_min"],
            "properties": {
              "type": { "const": "nwm_analysis_assim" },
              "availability_latency_min": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "availability_latency_min", "max_lead_hours"],
            "properties": {
              "type": { "const": "nwm_short_range" },
              "availability_latency_min": { "type": "integer", "minimum": 0 },
              "max_lead_hours": { "type": "integer", "minimum": 1, "maximum": 18 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "const": "scripted" },
              "path": { "type": "string", "description": "Parquet or CSV with columns t, feature_id, q_cms" },
              "availability_latency_min": { "type": "integer", "minimum": 0, "default": 0 }
            }
          }
        ]
      }
    },
    "state_estimation": {
      "type": "object", "additionalProperties": false,
      "required": ["bias_correction", "use_junction_inferences"],
      "properties": {
        "bias_correction": { "type": "string", "enum": ["none", "nearest_gauge_ratio"] },
        "use_junction_inferences": { "type": "boolean" },
        "ratio_clamp": {
          "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2,
          "default": [0.2, 10.0], "description": "[min, max] allowed observed/modelled ratio"
        }
      }
    },
    "boundary_forecast": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "members"],
      "properties": {
        "method": { "type": "string", "enum": ["persistence", "trend_relax", "nwm_short_range", "blend"] },
        "members": {
          "type": "object", "additionalProperties": false,
          "required": ["low", "mid", "high"],
          "properties": {
            "low": { "type": "number", "minimum": 0 },
            "mid": { "type": "number", "minimum": 0 },
            "high": { "type": "number", "minimum": 0 }
          },
          "description": "Rate-of-rise multipliers per member"
        },
        "relax_minutes": { "type": "integer", "minimum": 1, "default": 60 },
        "trend_window_minutes": { "type": "integer", "minimum": 5, "default": 30 }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "enum": ["none", "muskingum_cunge"] },
        "dt_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 5, "default": 1 }
      }
    },
    "roughness": {
      "type": "object", "additionalProperties": false,
      "properties": { "manning_n_scale": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 } }
    },
    "scenario_overrides": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "gauge_ref", "from"],
            "properties": {
              "type": { "const": "gauge_outage" },
              "gauge_ref": { "$ref": "common.schema.json#/$defs/gauge_ref" },
              "from": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
              "to": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "reach_ref", "factor", "from"],
            "properties": {
              "type": { "const": "reach_scale" },
              "reach_ref": { "$ref": "common.schema.json#/$defs/reach_ref" },
              "factor": { "type": "number", "minimum": 0 },
              "from": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
              "to": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
            }
          }
        ]
      }
    }
  }
}
