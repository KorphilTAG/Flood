# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql://flood:flood@localhost:5432/flood

# ...or set the individual PG* variables (used to build DATABASE_URL if it is unset).
PGHOST=localhost
PGPORT=5432
PGDATABASE=flood
PGUSER=flood
PGPASSWORD=flood

# Historical critic service (ingestion/critic/) -- required only when making a
# real (non-faked) request; the service itself starts without these set.
# OPENAI_API_KEY=sk-...
# AAR_INDEX_DIR=../data/aar/library
# CRITIC_OPENAI_MODEL=gpt-4o-mini
# Additional regeneration attempts allowed after the output validator
# rejects a citation (default 2, meaning up to 3 total generation attempts).
# CRITIC_MAX_REGENERATION_ATTEMPTS=2

# Citation quality evaluation (ingestion/critic_eval/, `python -m critic_eval
# run`) -- an offline RAGAS harness, run before a demo, that checks whether
# the critic's citations are actually faithful/relevant, not just real (that
# existence check is critic/validator.py's job, unchanged). A real run needs
# OPENAI_API_KEY (above), AAR_INDEX_DIR (above, a real built corpus), and
# network access -- see ingestion/README.md.
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# CRITIC_EVAL_SAMPLE_PATH=critic_eval/fixtures/sample_plans.json
# CRITIC_EVAL_REPORT_DIR=critic_eval/reports/
# Informational report-only warn thresholds (0-1); not hard gates.
# CRITIC_EVAL_FAITHFULNESS_WARN_THRESHOLD=0.7
# CRITIC_EVAL_CONTEXT_PRECISION_WARN_THRESHOLD=0.7
