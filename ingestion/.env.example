# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql://flood:flood@localhost:5432/flood

# ...or set the individual PG* variables (used to build DATABASE_URL if it is unset).
PGHOST=localhost
PGPORT=5432
PGDATABASE=flood
PGUSER=flood
PGPASSWORD=flood

# Historical critic service (ingestion/critic/) -- required only when making a
# real (non-faked) request; the service itself starts without these set.
# OPENAI_API_KEY=sk-...
# AAR_INDEX_DIR=../data/aar/library
# CRITIC_OPENAI_MODEL=gpt-4o-mini
# Additional regeneration attempts allowed after the output validator
# rejects a citation (default 2, meaning up to 3 total generation attempts).
# CRITIC_MAX_REGENERATION_ATTEMPTS=2
